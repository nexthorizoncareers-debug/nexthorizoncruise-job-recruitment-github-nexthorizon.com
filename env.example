# .env.example
# Copy this file to .env and fill in your actual values

# ==================== SERVER CONFIGURATION ====================
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# ==================== STRIPE PAYMENT GATEWAY ====================
STRIPE_PUBLIC_KEY=pk_live_your_public_key_here
STRIPE_SECRET_KEY=sk_live_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ==================== DATABASE ====================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/nexthorizon?retryWrites=true&w=majority
# For local development: MONGODB_URI=mongodb://localhost:27017/nexthorizon

# ==================== AUTHENTICATION ====================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=30d

# ==================== EMAIL CONFIGURATION ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=nexthorizoncareers@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=nexthorizoncareers@gmail.com

# ==================== COMPANY INFORMATION ====================
COMPANY_NAME=Next Horizon Careers
COMPANY_PHONE=+1 (816) 827-0407
COMPANY_EMAIL=nexthorizoncareers@gmail.com
COMPANY_WEBSITE=https://www.nexthorizoncareers.com

# ==================== CORS CONFIGURATION ====================
CORS_ORIGIN=http://localhost:3000,https://www.nexthorizoncareers.com

# ==================== LOGGING ====================
LOG_LEVEL=info

# ==================== API KEYS ====================
SENDGRID_API_KEY=your_sendgrid_api_key_here (optional alternative to SMTP)
